# ========================================================
# Zoe's Wild World - Environment Configuration
# ========================================================

# 1. Google Gemini API Key (Powers the "Ask Zoe's Safari Guide" AI search bar)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Pexels API Key (Free tier for high-def wildlife photos & video clips)
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# 3. Pixabay API Key (Free tier for supplementary animal video reels & photos)
# Get a free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Port configuration (Optional, default 3000)
PORT=3000
